NODE_ENV=development
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cater_phase_one
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

SESSION_SECRET=replace_with_a_32_plus_character_secret
CORS_ORIGIN=http://localhost:3000
PG_POOL_MAX=10
USE_PG_SESSION=false
# Keep demo records disabled for live/client environments. Set SEED_DEMO_DATA=true only for a throwaway local database.
SKIP_DEMO_SEED=true
SEED_DEMO_DATA=false
# One-time Railway production cleanup; leave disabled after the cleanup deploy.
RUN_LIVE_DATA_CLEANUP_ONCE=false
PDF_BROWSER_IDLE_MS=0
PDF_MAX_CONCURRENT=4
